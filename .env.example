THAIDOC_DATABASE_URL=sqlite:///./data/thaidoc.db
THAIDOC_ARTIFACT_DIR=./artifacts
THAIDOC_REDIS_URL=redis://redis:6379/0
THAIDOC_RETENTION_HOURS=24
THAIDOC_OCR_PROVIDER=tesseract
THAIDOC_OCR_PREPROCESS=true
