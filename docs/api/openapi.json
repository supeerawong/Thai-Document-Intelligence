  "components": {
    "schemas": {
      "Body_create_extraction_v1_extractions_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "schema": {
            "type": "string",
            "title": "Schema",
            "default": "thai_official_letter"
          },
          "mode": {
            "type": "string",
            "pattern": "^(rules|ai|auto)$",
            "title": "Mode",
            "default": "auto"
          },
          "execution": {
            "type": "string",
            "pattern": "^(auto|sync|async)$",
            "title": "Execution",
            "default": "auto"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_create_extraction_v1_extractions_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "succeeded",
              "failed",
              "expired"
            ],
            "title": "Status"
          },
          "progress": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Progress"
          },
          "schema_name": {
            "type": "string",
            "title": "Schema Name"
          },
          "execution": {
            "type": "string",
            "title": "Execution"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "error_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Detail"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "progress",
          "schema_name",
          "execution",
          "created_at",
          "updated_at"
        ],
        "title": "JobResponse"
      },
